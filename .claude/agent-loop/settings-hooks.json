{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Asus/.claude/hooks/check-loop-block.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Asus/.claude/hooks/erp-agent-guard.mjs\" card",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Asus/.claude/hooks/erp-agent-guard.mjs\" action",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Asus/.claude/hooks/erp-agent-guard.mjs\" start",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Asus/.claude/hooks/erp-agent-guard.mjs\" fail",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Asus/.claude/hooks/erp-agent-guard.mjs\" budget",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
